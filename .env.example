# BentoPDF Environment Variables
# Copy this file to .env.production and configure as needed.

# CORS Proxy for digital signature certificate chain fetching and RFC 3161
# timestamp requests. Required for the Timestamp PDF tool with the built-in
# providers: none of them answers a CORS preflight.
VITE_CORS_PROXY_URL=
VITE_CORS_PROXY_SECRET=

# Timestamp authorities offered by the Timestamp PDF tool (optional).
# Comma-separated "URL" or "Label=URL" entries; replaces the built-in list.
# Use this to point at a TSA that allows cross-origin requests (or at your own
# relay) so timestamping works without VITE_CORS_PROXY_URL. Configured origins
# are added to connect-src in the generated CSP at build time.
# Example: VITE_TSA_ENDPOINTS="My TSA=https://tsa.example.org/tsr"
VITE_TSA_ENDPOINTS=

# WASM Module URLs
# Pre-configured defaults enable advanced PDF features out of the box.
# For air-gapped / offline deployments, point these to your internal server (e.g., /wasm/pymupdf/).
VITE_WASM_PYMUPDF_URL=https://cdn.jsdelivr.net/npm/@bentopdf/pymupdf-wasm@0.11.16/
VITE_WASM_GS_URL=https://cdn.jsdelivr.net/npm/@bentopdf/gs-wasm@0.1.1/assets/
VITE_WASM_CPDF_URL=https://cdn.jsdelivr.net/npm/coherentpdf@2.5.5/dist/

# OCR assets (optional)
# Set all three together for self-hosted or air-gapped OCR.
# Leave empty to use Tesseract.js runtime defaults.
VITE_TESSERACT_WORKER_URL=
VITE_TESSERACT_CORE_URL=
VITE_TESSERACT_LANG_URL=
VITE_TESSERACT_AVAILABLE_LANGUAGES=
VITE_OCR_FONT_BASE_URL=

# Default UI language (build-time)
# Supported: en, ar, be, fr, de, es, zh, zh-TW, vi, tr, id, it, pt, nl, da, ko, sv, ru
VITE_DEFAULT_LANGUAGE=

# Custom branding (build-time)
# Replace the default BentoPDF branding with your own.
# Place your logo file in the public/ folder and set the path relative to it.
VITE_BRAND_NAME=
VITE_BRAND_LOGO=
VITE_FOOTER_TEXT=
